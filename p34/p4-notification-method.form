{
  "components": [
    {
      "label": "Notification Method (BR-11: choose the notification channel based on patient preference)",
      "values": [
        {
          "label": "paper",
          "value": "paper"
        },
        {
          "label": "digital",
          "value": "digital"
        },
        {
          "label": "translation",
          "value": "translation"
        },
        {
          "label": "representative",
          "value": "representative"
        }
      ],
      "type": "radio",
      "id": "Field_notificationForm_method",
      "key": "notificationForm.method",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Recipient Address / Mobile / Email / Authorized Representative Contact",
      "type": "textfield",
      "id": "Field_notificationForm_contactValue",
      "key": "notificationForm.contactValue",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 80
      }
    },
    {
      "label": "Notification Language (fill in when \"Translate Notification\" is selected)",
      "type": "textfield",
      "id": "Field_notificationForm_language",
      "key": "notificationForm.language",
      "validate": {
        "minLength": 2,
        "maxLength": 80
      }
    },
    {
      "label": "Remarks",
      "type": "textarea",
      "id": "Field_notificationForm_notes",
      "key": "notificationForm.notes",
      "description": "Special Assistance Needs, etc.",
      "validate": {
        "maxLength": 1000
      }
    }
  ],
  "schemaVersion": 19,
  "id": "p4-notification-method",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  }
}
