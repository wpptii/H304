<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_P3_AppointmentScheduling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_SchedulingRequested" name="SchedulingRequested" />
  <bpmn:message id="Message_SchedulingResult" name="SchedulingResult">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=referralId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_BookingConfirmed" name="BookingConfirmed" />
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="Participant_Hospital" name="Hospital Pool: Outpatient Appointment Team" processRef="Process_P3_AppointmentScheduling" />
    <bpmn:participant id="Participant_SchedulingService" name="External Pool: Scheduling Service" processRef="Process_P3_SchedulingPool" />
    <bpmn:messageFlow id="MessageFlow_SchedulingRequest" name="Scheduling Request" sourceRef="Throw_SchedulingRequest" targetRef="StartEvent_Scheduler_Requested" />
    <bpmn:messageFlow id="MessageFlow_SchedulingResult" name="Scheduling Result" sourceRef="EndEvent_Scheduler_SendResult" targetRef="Catch_SchedulingResult" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P3_AppointmentScheduling" name="Option 3: P3 New Patient Appointment Scheduling" isExecutable="true">
    <bpmn:documentation>Option 3: P3 New Patient Appointment Scheduling. Skeleton: Start "Referral Received and Accepted" -&gt; User Task "Create Appointment Request" Form -&gt; External Worker "Call Scheduling Service" topic: scheduling-request -&gt; XOR Scheduling successful? No -&gt; User Task "Keep Pending and Log Retry" Form -&gt; Timer retry -&gt; back to call the scheduling service; Yes -&gt; User Task "Confirm Appointment and Write Back" Form -&gt; Message "Notify Patient - Notification Team / Communication Service" -&gt; End. Rules: BR-04, BR-10, BR-13.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P3">
      <bpmn:lane id="Lane_BookingTeam" name="Outpatient Appointment Team">
        <bpmn:flowNodeRef>Task_CreateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ReferralAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SchedulingService" name="Cross-Pool Communication / Retry">
        <bpmn:flowNodeRef>Catch_RetryTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyNotificationTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmAndWriteBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BookingConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SchedulingSucceeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_SchedulingResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_SchedulingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldAndRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSchedulingRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_Start_To_CreateRequest" sourceRef="StartEvent_ReferralAccepted" targetRef="Task_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_CreateRequest_To_Scheduling" sourceRef="Task_CreateRequest" targetRef="Gateway_MergeSchedulingRequest" />
    <bpmn:sequenceFlow id="Flow_Scheduling_To_Gateway" sourceRef="Catch_SchedulingResult" targetRef="Gateway_SchedulingSucceeded" />
    <bpmn:sequenceFlow id="Flow_SchedulingSucceeded" name="yes" sourceRef="Gateway_SchedulingSucceeded" targetRef="Task_ConfirmAndWriteBack">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= scheduleStatus = "success"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SchedulingFailed" name="No: Keep Pending and Retry" sourceRef="Gateway_SchedulingSucceeded" targetRef="Task_HoldAndRetry" />
    <bpmn:sequenceFlow id="Flow_Hold_To_Timer" sourceRef="Task_HoldAndRetry" targetRef="Catch_RetryTimer" />
    <bpmn:sequenceFlow id="Flow_Timer_To_Scheduling" name="Retry: return to Call Scheduling Service" sourceRef="Catch_RetryTimer" targetRef="Gateway_MergeSchedulingRequest" />
    <bpmn:sequenceFlow id="Flow_Confirm_To_Notify" sourceRef="Task_ConfirmAndWriteBack" targetRef="Task_NotifyNotificationTeam" />
    <bpmn:sequenceFlow id="Flow_Notify_To_End" sourceRef="Task_NotifyNotificationTeam" targetRef="EndEvent_BookingConfirmed" />
    <bpmn:sequenceFlow id="Flow_Scheduling_To_Catch" sourceRef="Throw_SchedulingRequest" targetRef="Catch_SchedulingResult" />
    <bpmn:intermediateCatchEvent id="Catch_RetryTimer" name="Retry Wait">
      <bpmn:documentation>Wait for a back-off period before retrying the call to the scheduling service (BR-13). PT5S is used for the demo; in production change this to PT15M or as agreed with the scheduling service.</bpmn:documentation>
      <bpmn:incoming>Flow_Hold_To_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_To_Scheduling</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Retry">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CreateRequest" name="Create Appointment Request">
      <bpmn:documentation>BR-04: The outpatient appointment team creates the appointment request for the accepted new patient and records the specialty, priority, preferred time window and referral number.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p3-create-request" />
        <zeebe:assignmentDefinition candidateGroups="appointment-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_CreateRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateRequest_To_Scheduling</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_ReferralAccepted" name="Referral Received and Accepted">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p3-start-referral" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_To_CreateRequest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_NotifyNotificationTeam" name="Notify Patient – Notification Team / Communication Service">
      <bpmn:documentation>Message: Deliver BookingConfirmed to the patient notification team / communication service (cross-pool message). Job type (topic) = notify-notification-team.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-notification-team" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="BookingConfirmed" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= referralId" target="referralId" />
          <zeebe:input source="= slotReference" target="slotReference" />
          <zeebe:input source="= confirmForm.appointmentDateTime" target="appointmentDateTime" />
          <zeebe:input source="= confirmForm.location" target="location" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Confirm_To_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmAndWriteBack" name="Confirm Appointment and Write Back">
      <bpmn:documentation>BR-13: After successful scheduling, confirm the appointment and write the result back to the case / scheduling system, recording the appointment time and location.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p3-confirm-booking" />
        <zeebe:assignmentDefinition candidateGroups="appointment-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SchedulingSucceeded</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_To_Notify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_BookingConfirmed" name="Appointment Scheduled and Notified">
      <bpmn:incoming>Flow_Notify_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_SchedulingSucceeded" name="Scheduling successful?" default="Flow_SchedulingFailed">
      <bpmn:incoming>Flow_Scheduling_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SchedulingSucceeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_SchedulingFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_SchedulingResult" name="Scheduling Result">
      <bpmn:documentation>Wait for the external scheduling service to return SchedulingResult (correlation key = referralId). The receipt variables (scheduleStatus / slotReference / failureReason) enter this instance with the message.</bpmn:documentation>
      <bpmn:incoming>Flow_Scheduling_To_Catch</bpmn:incoming>
      <bpmn:outgoing>Flow_Scheduling_To_Gateway</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_SchedulingResult" messageRef="Message_SchedulingResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_SchedulingRequest" name="Call Scheduling Service">
      <bpmn:documentation>Message: Deliver SchedulingRequested to the external pool (scheduling service) and start its process instance. Job type = send-scheduling-request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-scheduling-request" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="SchedulingRequested" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeScheduling_To_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Scheduling_To_Catch</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_SchedulingRequested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_HoldAndRetry" name="Keep Pending and Log Retry">
      <bpmn:documentation>BR-10: When scheduling fails, keep the appointment request as "Pending", record the failure reason and the retry plan, and let the Timer trigger the retry.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p3-hold-retry" />
        <zeebe:assignmentDefinition candidateGroups="appointment-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SchedulingFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_Hold_To_Timer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_MergeScheduling_To_Request" name="Merged: call the scheduling service" sourceRef="Gateway_MergeSchedulingRequest" targetRef="Throw_SchedulingRequest" />
    <bpmn:exclusiveGateway id="Gateway_MergeSchedulingRequest" name="Retry loop merge: call the scheduling service again">
      <bpmn:incoming>Flow_CreateRequest_To_Scheduling</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_To_Scheduling</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeScheduling_To_Request</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:process id="Process_P3_SchedulingPool" name="Option 3: P3 New Patient Appointment Scheduling (Scheduling Service)" isExecutable="true">
    <bpmn:documentation>External pool: On receiving the scheduling request, the scheduling service allocates a slot and returns the result to the hospital.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P3_Scheduler">
      <bpmn:lane id="Lane_Scheduler" name="Scheduling Service">
        <bpmn:flowNodeRef>StartEvent_Scheduler_Requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scheduler_ProcessRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Scheduler_SendResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Scheduler_Requested" name="Scheduling Request Received">
      <bpmn:outgoing>Flow_Scheduler_Start_To_Task</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Scheduler_Start" messageRef="Message_SchedulingRequested" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Scheduler_ProcessRequest" name="Allocate Slot">
      <bpmn:documentation>External Worker: The scheduling service allocates a slot and writes back scheduleStatus / slotReference / failureReason. Job type = scheduler-process-request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduler-process-request" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="scheduler" value="external-scheduling-service" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Scheduler_Start_To_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_Scheduler_Task_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Scheduler_SendResult" name="Return Scheduling Result">
      <bpmn:documentation>Message: Deliver SchedulingResult (correlation key = referralId). Job type = scheduler-send-result.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduler-send-result" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Scheduler_Task_To_End</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Scheduler_End" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Scheduler_Start_To_Task" sourceRef="StartEvent_Scheduler_Requested" targetRef="Task_Scheduler_ProcessRequest" />
    <bpmn:sequenceFlow id="Flow_Scheduler_Task_To_End" sourceRef="Task_Scheduler_ProcessRequest" targetRef="EndEvent_Scheduler_SendResult" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P3">
    <bpmndi:BPMNPlane id="BPMNPlane_P3" bpmnElement="Collaboration_P3">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="40" width="1400" height="680" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SchedulingService_di" bpmnElement="Lane_SchedulingService" isHorizontal="true">
        <dc:Bounds x="170" y="260" width="1370" height="440" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BookingTeam_di" bpmnElement="Lane_BookingTeam" isHorizontal="true">
        <dc:Bounds x="170" y="60" width="1370" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_RetryTimer_di" bpmnElement="Catch_RetryTimer">
        <dc:Bounds x="742" y="440" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735" y="416" width="51" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateRequest_di" bpmnElement="Task_CreateRequest">
        <dc:Bounds x="560" y="110" width="220" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ReferralAccepted_di" bpmnElement="StartEvent_ReferralAccepted">
        <dc:Bounds x="222" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="196" y="175" width="89" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyNotificationTeam_di" bpmnElement="Task_NotifyNotificationTeam">
        <dc:Bounds x="1260" y="430" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmAndWriteBack_di" bpmnElement="Task_ConfirmAndWriteBack">
        <dc:Bounds x="1260" y="270" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_BookingConfirmed_di" bpmnElement="EndEvent_BookingConfirmed">
        <dc:Bounds x="1342" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1323" y="665" width="74" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SchedulingSucceeded_di" bpmnElement="Gateway_SchedulingSucceeded" isMarkerVisible="true">
        <dc:Bounds x="995" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="991" y="247.5" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_SchedulingResult_di" bpmnElement="Catch_SchedulingResult">
        <dc:Bounds x="792" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="766" y="268" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_SchedulingRequest_di" bpmnElement="Throw_SchedulingRequest">
        <dc:Bounds x="512" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="491" y="254.5" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HoldAndRetry_di" bpmnElement="Task_HoldAndRetry">
        <dc:Bounds x="910" y="600" width="220" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeSchedulingRequest_di" bpmnElement="Gateway_MergeSchedulingRequest" isMarkerVisible="true">
        <dc:Bounds x="342" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="244" y="293" width="88" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_CreateRequest_di" bpmnElement="Flow_Start_To_CreateRequest">
        <di:waypoint x="258" y="150" />
        <di:waypoint x="560" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CreateRequest_To_Scheduling_di" bpmnElement="Flow_CreateRequest_To_Scheduling">
        <di:waypoint x="670" y="190" />
        <di:waypoint x="670" y="246" />
        <di:waypoint x="360" y="246" />
        <di:waypoint x="360" y="302" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Scheduling_To_Gateway_di" bpmnElement="Flow_Scheduling_To_Gateway">
        <di:waypoint x="828" y="310" />
        <di:waypoint x="995" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SchedulingSucceeded_di" bpmnElement="Flow_SchedulingSucceeded">
        <di:waypoint x="1045" y="310" />
        <di:waypoint x="1260" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1144" y="292" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SchedulingFailed_di" bpmnElement="Flow_SchedulingFailed">
        <di:waypoint x="1020" y="335" />
        <di:waypoint x="1020" y="600" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="516" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Hold_To_Timer_di" bpmnElement="Flow_Hold_To_Timer">
        <di:waypoint x="910" y="640" />
        <di:waypoint x="760" y="640" />
        <di:waypoint x="760" y="476" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_To_Scheduling_di" bpmnElement="Flow_Timer_To_Scheduling">
        <di:waypoint x="742" y="458" />
        <di:waypoint x="360" y="458" />
        <di:waypoint x="360" y="338" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="380" width="77" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confirm_To_Notify_di" bpmnElement="Flow_Confirm_To_Notify">
        <di:waypoint x="1360" y="350" />
        <di:waypoint x="1360" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notify_To_End_di" bpmnElement="Flow_Notify_To_End">
        <di:waypoint x="1360" y="510" />
        <di:waypoint x="1360" y="622" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Scheduling_To_Catch_di" bpmnElement="Flow_Scheduling_To_Catch">
        <di:waypoint x="548" y="310" />
        <di:waypoint x="792" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MergeScheduling_To_Request_di" bpmnElement="Flow_MergeScheduling_To_Request">
        <di:waypoint x="378" y="320" />
        <di:waypoint x="445" y="320" />
        <di:waypoint x="445" y="310" />
        <di:waypoint x="512" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="373" y="295" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_SchedulingService_di" bpmnElement="Participant_SchedulingService" isHorizontal="true">
        <dc:Bounds x="140" y="830" width="1400" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Scheduler_di" bpmnElement="Lane_Scheduler" isHorizontal="true">
        <dc:Bounds x="170" y="830" width="1370" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Scheduler_Requested_di" bpmnElement="StartEvent_Scheduler_Requested">
        <dc:Bounds x="300" y="902" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="274" y="945" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scheduler_ProcessRequest_di" bpmnElement="Task_Scheduler_ProcessRequest">
        <dc:Bounds x="430" y="880" width="220" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Scheduler_SendResult_di" bpmnElement="EndEvent_Scheduler_SendResult">
        <dc:Bounds x="760" y="902" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="945" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Scheduler_Start_To_Task_di" bpmnElement="Flow_Scheduler_Start_To_Task">
        <di:waypoint x="336" y="920" />
        <di:waypoint x="430" y="920" />
