<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_P7_FundingDetermination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_FundingApprovalRequested" name="FundingApprovalRequested" />
  <bpmn:message id="Message_FundingApprovalResult" name="FundingApprovalResult">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=appointmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_P7">
    <bpmn:participant id="Participant_Hospital" name="Hospital Pool: Finance Team / Funding Agencies · Insurance Companies" processRef="Process_P7_FundingDetermination" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P7_FundingDetermination" name="Selection 6: Funding Determination and Recording" isExecutable="true">
    <bpmn:documentation>Selection 6: Funding Determination and Recording. Skeleton: Start "Treatment appointment request authorized" → User Task "Determine the source of funding" Form (hospital/insurance/funding agency/self-pay, authorization reference, approved amount, restrictions) → External Worker "Verify funding" topic: funding-validation → XOR Is approval required? Yes → Message "Request funding approval" → Message Catch "Approval outcome" → User Task "Record approval" Form → End; No → User Task "Record self-pay/waiver" Form → End. Rules: BR-14, BR-15, BR-17. Highlight: funding is a payment pre-gate.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P7">
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>Gateway_ApprovalRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordExemption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ApprovalRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ExemptionRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_RequestAuthorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateFunding</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Funder" name="Funding Agency / Insurance Company (Cross-Pool Message)">
        <bpmn:flowNodeRef>Task_RequestApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ApprovalResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_Start_To_Determine" sourceRef="StartEvent_RequestAuthorized" targetRef="Task_DetermineFunding" />
    <bpmn:sequenceFlow id="Flow_Determine_To_Validate" sourceRef="Task_DetermineFunding" targetRef="Task_ValidateFunding" />
    <bpmn:sequenceFlow id="Flow_Validate_To_Gateway" sourceRef="Task_ValidateFunding" targetRef="Gateway_ApprovalRequired" />
    <bpmn:exclusiveGateway id="Gateway_ApprovalRequired" name="Is approval required?" default="Flow_NoApprovalNeeded">
      <bpmn:incoming>Flow_Validate_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalNeeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoApprovalNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ApprovalNeeded" name="yes" sourceRef="Gateway_ApprovalRequired" targetRef="Task_RequestApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoApprovalNeeded" name="no" sourceRef="Gateway_ApprovalRequired" targetRef="Task_RecordExemption" />
    <bpmn:serviceTask id="Task_RequestApproval" name="Funding approval request">
      <bpmn:documentation>Message: Deliver FundingApprovalRequested to the funding agency / insurance company. Job type (topic) = request-funding-approval.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-funding-approval" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="FundingApprovalRequested" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= appointmentId" target="appointmentId" />
          <zeebe:input source="= fundingForm.fundingSource" target="fundingSource" />
          <zeebe:input source="= fundingForm.authorizationRef" target="authorizationRef" />
          <zeebe:input source="= fundingForm.approvedAmount" target="approvedAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_To_Catch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Request_To_Catch" sourceRef="Task_RequestApproval" targetRef="Catch_ApprovalResult" />
    <bpmn:sequenceFlow id="Flow_Catch_To_Record" name="Approval result received" sourceRef="Catch_ApprovalResult" targetRef="Task_RecordApproval" />
    <bpmn:userTask id="Task_RecordApproval" name="Approval record">
      <bpmn:documentation>BR-17: Record the funding approval result and restrictions in the medical case as the credential for the payment pre-gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p7-record-approval" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Catch_To_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Record_To_End" sourceRef="Task_RecordApproval" targetRef="EndEvent_ApprovalRecorded" />
    <bpmn:endEvent id="EndEvent_ApprovalRecorded" name="Approval recorded">
      <bpmn:incoming>Flow_Record_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RecordExemption" name="Record Self-Pay / Waiver">
      <bpmn:documentation>BR-15: Cases that do not require approval (self-pay / waiver) must also record the funding source and amount to keep the payment pre-gate complete.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p7-record-exemption" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoApprovalNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_Exemption_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Exemption_To_End" sourceRef="Task_RecordExemption" targetRef="EndEvent_ExemptionRecorded" />
    <bpmn:endEvent id="EndEvent_ExemptionRecorded" name="Self-Pay / Waiver Recorded">
      <bpmn:incoming>Flow_Exemption_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_ApprovalResult" name="Approval outcome">
      <bpmn:documentation>Wait for the approval receipt from the funding agency / insurance company (message FundingApprovalResult, correlation key = appointmentId, defined on the bpmn:message element).</bpmn:documentation>
      <bpmn:incoming>Flow_Request_To_Catch</bpmn:incoming>
      <bpmn:outgoing>Flow_Catch_To_Record</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ApprovalResult" messageRef="Message_FundingApprovalResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="StartEvent_RequestAuthorized" name="appointment request has been authorized">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p7-start-request" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_To_Determine</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DetermineFunding" name="Determine the source of funding">
      <bpmn:documentation>BR-14: The finance team confirms and records the funding source (hospital / insurance / funding agency / self-pay), authorization reference, approved amount and restrictions.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="p7-funding-source" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Determine</bpmn:incoming>
      <bpmn:outgoing>Flow_Determine_To_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateFunding" name="Verify funding">
      <bpmn:documentation>External Worker: Validate the authorization reference and approved amount (BR-15: payment pre-gate). Job type (topic) = funding-validation. Writes back fundingValid and approvalRequired.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="funding-validation" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="validation" value="funding-validation-service" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="= fundingForm.fundingSource" target="fundingSource" />
          <zeebe:input source="= fundingForm.authorizationRef" target="authorizationRef" />
          <zeebe:input source="= fundingForm.approvedAmount" target="approvedAmount" />
          <zeebe:input source="= fundingForm.restrictions" target="restrictions" />
          <zeebe:input source="= appointmentId" target="appointmentId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Determine_To_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P7">
    <bpmndi:BPMNPlane id="BPMNPlane_P7" bpmnElement="Collaboration_P7">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="80" width="1460" height="660" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Funder_di" bpmnElement="Lane_Funder" isHorizontal="true">
        <dc:Bounds x="170" y="460" width="1430" height="280" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="170" y="80" width="1430" height="380" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApprovalRequired_di" bpmnElement="Gateway_ApprovalRequired" isMarkerVisible="true">
        <dc:Bounds x="800" y="163" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="814" y="138" width="54" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestApproval_di" bpmnElement="Task_RequestApproval">
        <dc:Bounds x="380" y="580" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordApproval_di" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="900" y="300" width="180" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ApprovalRecorded_di" bpmnElement="EndEvent_ApprovalRecorded">
        <dc:Bounds x="1200" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1174" y="365" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordExemption_di" bpmnElement="Task_RecordExemption">
        <dc:Bounds x="980" y="495" width="180" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ExemptionRecorded_di" bpmnElement="EndEvent_ExemptionRecorded">
        <dc:Bounds x="1260" y="517" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1240" y="560" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_ApprovalResult_di" bpmnElement="Catch_ApprovalResult">
        <dc:Bounds x="712" y="517" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="636" y="528" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_RequestAuthorized_di" bpmnElement="StartEvent_RequestAuthorized">
        <dc:Bounds x="200" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="175" y="188" width="86" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineFunding_di" bpmnElement="Task_DetermineFunding">
        <dc:Bounds x="300" y="120" width="220" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateFunding_di" bpmnElement="Task_ValidateFunding">
        <dc:Bounds x="580" y="120" width="180" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Determine_di" bpmnElement="Flow_Start_To_Determine">
        <di:waypoint x="236" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Determine_To_Validate_di" bpmnElement="Flow_Determine_To_Validate">
        <di:waypoint x="520" y="160" />
        <di:waypoint x="580" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_To_Gateway_di" bpmnElement="Flow_Validate_To_Gateway">
        <di:waypoint x="760" y="160" />
        <di:waypoint x="780" y="160" />
        <di:waypoint x="780" y="188" />
        <di:waypoint x="800" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalNeeded_di" bpmnElement="Flow_ApprovalNeeded">
        <di:waypoint x="825" y="213" />
        <di:waypoint x="825" y="240" />
        <di:waypoint x="480" y="240" />
        <di:waypoint x="480" y="580" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="487" y="401" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoApprovalNeeded_di" bpmnElement="Flow_NoApprovalNeeded">
        <di:waypoint x="850" y="188" />
        <di:waypoint x="885" y="188" />
        <di:waypoint x="885" y="535" />
        <di:waypoint x="980" y="535" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="863" y="373" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Request_To_Catch_di" bpmnElement="Flow_Request_To_Catch">
        <di:waypoint x="580" y="630" />
        <di:waypoint x="730" y="630" />
        <di:waypoint x="730" y="553" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Catch_To_Record_di" bpmnElement="Flow_Catch_To_Record">
        <di:waypoint x="730" y="517" />
        <di:waypoint x="730" y="490" />
        <di:waypoint x="960" y="490" />
        <di:waypoint x="960" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="808" y="465" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Record_To_End_di" bpmnElement="Flow_Record_To_End">
        <di:waypoint x="1080" y="340" />
        <di:waypoint x="1200" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Exemption_To_End_di" bpmnElement="Flow_Exemption_To_End">
        <di:waypoint x="1160" y="535" />
        <di:waypoint x="1260" y="535" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
