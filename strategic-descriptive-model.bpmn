        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClinicalReview_di" bpmnElement="Task_ClinicalReview">
        <dc:Bounds x="800" y="360" width="190" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ArrangeAppointment_di" bpmnElement="Task_ArrangeAppointment">
        <dc:Bounds x="1040" y="470" width="190" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformPatient_di" bpmnElement="Task_InformPatient">
        <dc:Bounds x="1280" y="470" width="190" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultationTreatment_di" bpmnElement="Task_ConsultationTreatment">
