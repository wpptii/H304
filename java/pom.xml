<?xml version="1.0" encoding="UTF-8"?>
<!--
  HPAS 作业 —— Camunda 8 Spring Boot Job Worker

  技术栈与课程范例 (Messgae Example) 保持一致：
    Spring Boot 父 POM 4.0.5 + Java 21+
    io.camunda:camunda-spring-boot-starter:8.9.0   （新统一客户端 io.camunda.client.*）
    @JobWorker / @Variable 注解风格

  运行方式见 README.md（启动 Worker / 发消息 / 演示各分支）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>hpas</groupId>
    <artifactId>hpas-workers</artifactId>
    <version>1.0.0</version>
    <name>HPAS Camunda 8 Workers</name>
    <description>HPAS 作业：8 个流程模型对应的 Job Worker（Camunda 8.9）</description>

    <properties>
        <java.version>21</java.version>
        <camunda.version>8.9.0</camunda.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-spring-boot-starter</artifactId>
            <version>${camunda.version}</version>
        </dependency>

        <!--
          数据库持久层（新增）：
          流程变量只活在流程实例里；下面这些依赖让「案例数据」落到真正的数据库文件里，
          流程结束 / 应用重启后依然存在，并可用 SQL 做跨实例的统计报表。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 演示用文件型数据库（runtime：应用只需要 JDBC 驱动，编译期用不到） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 只读演示 API（/api/db/**，监听 8090；8080 留给 Camunda） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 浏览器里的 H2 控制台（http://127.0.0.1:8090/h2-console）。
             Spring Boot 4 起 H2 控制台的自动配置被拆成独立模块，starter-web / starter-data-jpa
             都不再传递引入，少了它就只会 404（Whitelabel Error Page）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>

        <!--
          生产环境可换成 MySQL / PostgreSQL：把上面的 h2 换成其中一个（或额外加上）即可，
          并在 application.properties 里改 spring.datasource.url / driver-class-name。

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
