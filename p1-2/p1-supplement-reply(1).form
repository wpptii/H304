      "id": "Field_supplementForm_providedItems",
      "key": "supplementForm.providedItems",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Reply Channel",
      "values": [
        {
          "label": "Email",
          "value": "email"
        },
        {
