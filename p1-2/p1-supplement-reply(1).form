          "value": "paper"
        },
        {
          "label": "System integration",
          "value": "interface"
        },
        {
          "label": "Phone confirmation",
          "value": "phone"
        }
      ],
      "type": "radio",
      "id": "Field_supplementForm_replyChannel",
      "key": "supplementForm.replyChannel",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Reception Registrar (Medical Secretary)",
      "type": "textfield",
      "id": "Field_supplementForm_receivedBy",
      "key": "supplementForm.receivedBy",
      "validate": {
        "required": true
      }
    },
    {
