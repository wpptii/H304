{
  "components": [
    {
      "label": "Referral application number (also serves as the reference key for the 'waiting for additional documents' message)",
      "type": "textfield",
      "id": "Field_referralId",
      "key": "referralId",
      "validate": {
        "required": true,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,29}$"
      }
    },
    {
      "label": "Patient Name",
      "type": "textfield",
      "id": "Field_patientName",
      "key": "patientName",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 80
      }
    },
    {
      "label": "Referral Source (GP / Other Organization)",
      "type": "textfield",
      "id": "Field_referralSource",
      "key": "referralSource",
      "validate": {
        "required": true,
        "minLength": 2,
        "maxLength": 80
      }
    }
  ],
  "schemaVersion": 19,
  "id": "p2-start-referral",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.0"
  }
}
